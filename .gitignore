# ==============================================================================
# WHYNOTUPSC / REDROOM — GIT IGNORE & SECURITY SPECIFICATION
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js Build Outputs
/.next/
/out/
/build
scratch/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secret Security (NEVER Commit Real Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.key
*.pem
*.secret
!/.env.example

# Supabase & Local Database Staging
.supabase
supabase/.temp

# Vercel Deployment & Telemetry
.vercel

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts
