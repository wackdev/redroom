# ==============================================================================
# WHYNOTUPSC / REDROOM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to `.env.local` for local development.
# Set these variables in Vercel Dashboard (Project Settings > Environment Variables)
# and GitHub Actions (Settings > Secrets and variables > Actions).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required)
# Retrieve from: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Publishable Key (optional alias)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase Service Role Key (Elevated secret — keep private in Vercel & GitHub Secrets)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supavisor Connection Pooler (Transaction Mode, Port 6543 - Prevents connection exhaustion on Free Tier)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. AI INFERENCE & MODEL API TOKENS (Optional)
# ------------------------------------------------------------------------------
# Hugging Face Serverless Inference API Token
HF_TOKEN=your_huggingface_api_token_here

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT NOTIFICATIONS & WEBHOOKS (Optional)
# ------------------------------------------------------------------------------
# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Webhook Verification Secret
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Telegram Public Webhook Base URL
TELEGRAM_PUBLIC_URL=https://your-domain.vercel.app
