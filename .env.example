# ==============================================================================
# REDROOM (WHYNOTUPSC OS) — ENVIRONMENT CONFIGURATION BLUEPRINT (.env.example)
# Copy this file to `.env.local` for local development.
# Set these variables in Vercel Dashboard (Project Settings > Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required for Cloud Sync & Realtime)
# Retrieve from: Supabase Dashboard > Project Settings > API & Database
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Elevated secret — keep private in Vercel / Server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supavisor Connection Pooler (Port 6543, Transaction Mode with pgbouncer=true)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Supabase PostgreSQL Connection (Port 5432, Session Mode for migrations)
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres


# ------------------------------------------------------------------------------
# 2. AI MODEL PROVIDER API KEYS (Optional — System has zero-auth fallback)
# Add keys to unlock ultra-low latency & 70B+ parameter models
# ------------------------------------------------------------------------------
# Hugging Face Serverless Token (Recommended: Qwen 2.5 72B & Llama 3.3 70B)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq Cloud API Key (Ultra-low latency TTFT)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key (Gemini 2.0 Flash)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API Key (Llama 3.3 70B Free Tier)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------------------------
# 3. TELEGRAM COMMANDER GATEWAY & AUTOMATED CRONS (Required for Telegram Bot)
# ------------------------------------------------------------------------------
# Telegram Bot API Token (Obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your Private Admin Telegram Chat ID (Only you can broadcast & query telemetry)
# Tip: Message @userinfobot on Telegram to get your numeric Chat ID
TELEGRAM_CHAT_ID=123456789
ADMIN_TELEGRAM_CHAT_ID=123456789

# Telegram Webhook Verification Secret (Any random 32-character string)
TELEGRAM_WEBHOOK_SECRET=redroom_telemetry_secret_token_2026

# Telegram Public Base URL for Webhook Registration
TELEGRAM_PUBLIC_URL=https://your-app-name.vercel.app


# ------------------------------------------------------------------------------
# 4. MASTER ADMINISTRATOR OVERRIDE (Optional)
# ------------------------------------------------------------------------------
# Custom Master Admin Password (Overrides default wacky@0808)
ADMIN_PASSWORD=your_custom_admin_password_here


# ------------------------------------------------------------------------------
# 5. PUBLIC WEB APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app-name.vercel.app
